<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FF0D0D0D"   android:centerColor="#FF1A1A1A"  android:endColor="#FF23211D"     android:useLevel="false" />
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="45"
                android:startColor="#40D4AF37"  android:centerColor="#40B5A77B" android:endColor="#40D4AF37"    android:useLevel="false" />
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#55994C00"  android:centerColor="#55B5882B" android:endColor="#55994C00"    android:useLevel="false" />
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#99F0E68C"  android:centerColor="#66FFFFFF" android:endColor="#00000000"    android:useLevel="false" />
            <corners android:radius="14dp"/>
        </shape>
    </item>

</layer-list>