<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/radiobuttonhandler"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/nunitosans"
        android:text="Choose your Image Profile"
        android:textColor="@color/aurora_classic_start"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="130dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20sp">

                <ImageView
                    android:id="@+id/img_1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/profile_img"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/anime_badas" />

                <TextView
                    android:id="@+id/name1"
                    android:layout_marginTop="5sp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:text="Dragon"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/pointhandler"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20sp">

                <ImageView
                    android:id="@+id/img_2"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/profile_img"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/anime_badas" />

                <TextView
                    android:id="@+id/name2"
                    android:layout_marginTop="5sp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:text="Dragon"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/pointhandler"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20sp">

                <ImageView
                    android:id="@+id/img_3"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/profile_img"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/anime_badas" />

                <TextView
                    android:id="@+id/name3"
                    android:layout_marginTop="5sp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:text="Dragon"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/pointhandler"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20sp">

                <ImageView
                    android:id="@+id/img_4"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/profile_img"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/anime_badas" />

                <TextView
                    android:id="@+id/name4"
                    android:layout_marginTop="5sp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:text="Dragon"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/pointhandler"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20sp">

                <ImageView
                    android:id="@+id/img_5"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/profile_img"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/anime_badas" />

                <TextView
                    android:id="@+id/name5"
                    android:layout_marginTop="5sp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:text="Dragon"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/pointhandler"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_social_background"
        android:orientation="vertical"
        android:padding="16dp">
<ViewFlipper
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:autoStart="true"
    android:flipInterval="3000">
    <TextView
        android:id="@+id/title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pointhandler"
        android:fontFamily="@font/nunitosans"
        android:padding="5dp"
        android:text="Title"
        android:textColor="@color/white"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pointhandler"
        android:fontFamily="@font/nunitosans"
        android:padding="5dp"
        android:text="Title"
        android:textColor="@color/white"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/title3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pointhandler"
        android:fontFamily="@font/nunitosans"
        android:padding="5dp"
        android:text="Title"
        android:textColor="@color/white"
        android:textSize="15sp" />
    <TextView
    android:id="@+id/title4"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/pointhandler"
    android:fontFamily="@font/nunitosans"
    android:padding="5dp"
    android:text="Title"
    android:textColor="@color/white"
    android:textSize="15sp" />
    <TextView
    android:id="@+id/title5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/pointhandler"
    android:fontFamily="@font/nunitosans"
    android:padding="5dp"
    android:text="Title"
    android:textColor="@color/white"
    android:textSize="15sp" />



</ViewFlipper>

<ViewFlipper
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:autoStart="true"
    android:flipInterval="3000">
    <TextView
        android:id="@+id/decs1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunitosans"
        android:text="@string/lorem"
        android:textColor="@color/textpendukung" />
    <TextView
        android:id="@+id/decs2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunitosans"
        android:text="@string/lorem"
        android:textColor="@color/textpendukung" />
    <TextView
        android:id="@+id/decs3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunitosans"
        android:text="@string/lorem"
        android:textColor="@color/textpendukung" />
    <TextView
        android:id="@+id/decs4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunitosans"
        android:text="@string/lorem"
        android:textColor="@color/textpendukung" />
    <TextView
    android:id="@+id/decs5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/nunitosans"
    android:text="@string/lorem"
    android:textColor="@color/textpendukung" />


</ViewFlipper>

    </LinearLayout>
</LinearLayout>
