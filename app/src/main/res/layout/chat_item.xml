<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/border_radius_setting"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="10dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:background="@drawable/circle_navbar"
            android:id="@+id/photoprofile"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_guest"/>
<LinearLayout

    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/black"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_marginTop="5sp"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25/10/2025"
            android:fontFamily="@font/nunitosans"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/textpendukung"/>
        <TextView
            android:layout_marginStart="5dp"
            android:layout_marginTop="5sp"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13:32:32"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="@color/textpendukung"/>
    </LinearLayout>



</LinearLayout>


        <RatingBar
            android:id="@+id/ratingBarItem"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:isIndicator="true"
            android:rating="5" />
    </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/tvChat"
        android:layout_width="0dp"
        android:layout_weight="5"
        android:layout_height="wrap_content"
        android:text="Komentarnya di sini"
        android:textColor="#333"
        android:layout_marginTop="4dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Hapus"
        android:textSize="10dp"
        app:backgroundTint="#E57373"
        android:fontFamily="@font/poppins"

        android:textColor="@android:color/white"
        android:layout_marginTop="6dp"
        android:layout_gravity="end"/>

</LinearLayout>


</LinearLayout>
